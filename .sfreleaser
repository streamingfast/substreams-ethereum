global:
  language: rust
  variant: library
release:
  pre-build-hooks:
    - .sfreleaser.pre-release.sh "{{ .release.Version }}"
    - substreams pack -o "{{ .buildDir }}/{package.name}-{{ .release.Version }}.spkg" substreams.yaml
  upload-extra-assets:
    - "{{ .buildDir }}/{package.name}-{{ .release.Version }}.spkg"
  # Must be specified in publish order
  rust-crates:
  - substreams-ethereum-core
  - substreams-ethereum-abigen
  - substreams-ethereum-derive
  - substreams-ethereum
